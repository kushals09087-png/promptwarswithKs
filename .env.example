# ==============================================================================
# LabLink Nexus - Environment Variables Configuration
# ==============================================================================

# Demo Mode (Required: true for zero-friction hackathon evaluation with 6 seeded accounts)
DEMO_MODE=true

# Next.js Port (Default: 3000 locally, 8080 on Cloud Run)
PORT=3000

# Cryptographic Demo Session Secret (used for HMAC-SHA256 demo token signatures)
DEMO_SESSION_SECRET=lablink_nexus_production_demo_secret_2026_campus_eval

# Google Gemini API Key (optional for production GenAI recommendations; deterministic fallback is active if unset)
# GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Postgres Configuration (Optional in DEMO_MODE; required for production Supabase auth & live database)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
